andom() * keys.length)];\n  return {\n    shape: shapes[key],\n    color: colors[key],\n    x: Math.floor((COLS - shapes[key][0].length) / 2),\n    y: 0,\n    type: key\n  };\n}\n\nfunction rotate(matrix) {\n  const N = matrix.length;\n  const result = Array.from({ length: N }, () => Array(N).fill(0));\n  for (let y = 0; y < N; y++) {\n    for (let x = 0; x < N; x++) {\n      result[x][N - 1 - y] = matrix[y][x];\n    }\n  }\n  return result;\n}\n\nfunction isValidPosition(piece, offsetX = 0, offsetY = 0, newShape = null) {\n  const shape = newShape || piece.shape;\n  for (let y = 0; y < shape.length; y++) {\n    for (let x = 0; x < shape[y].length; x++) {\n      if (shape[y][x]) {\n        const nx = piece.x + x + offsetX;\n        const ny = piece.y + y + offsetY;\n        if (nx < 0 || nx >= COLS || ny >= ROWS) return false;\n        if (ny >= 0 && board[ny][nx]) return false;\n      }\n    }\n  }\n  return true;\n}\n\nfunction lockPiece(piece) {\n  for (let y = 0; y < piece.shape.length; y++) {\n    for (let x = 0; x < piece.shape[y].length; x++) {\n      if (piece.shape[y][x]) {\n        const ny = piece.y + y;\n        const nx = piece.x + x;\n        if (ny >= 0) board[ny][nx] = piece.color;\n      }\n    }\n  }\n}\n\nfunction clearLines() {\n  let cleared = 0;\n  for (let y = ROWS - 1; y >= 0; y--) {\n    if (board[y].every(c => c !== 0)) {\n      board.splice(y, 1);\n      board.unshift(Array(COLS).fill(0));\n      cleared++;\n      y++;\n    }\n  }\n  if (cleared > 0) {\n    lines += cleared;\n    score += [0, 100, 300, 500, 800][cleared] * level;\n    level = Math.floor(lines / 10) + 1;\n    dropInterval = Math.max(100, 1000 - (level - 1) * 80);\n    updateUI();\n  }\n}\n\nfunction spawnPiece() {\n  current = next || randomPiece();\n  next = randomPiece();\n  if (!isValidPosition(current)) {\n    gameOver = true;\n    drawGameOver();\n    return;\n  }\n  drawNext();\n}\n\nfunction hardDrop() {\n  if (!current || gameOver || paused) return;\n  while (isValidPosition(current, 0, 1)) {\n    current.y++;\n    score += 2;\n  }\n  updateUI();\n  lock();\n}\n\nfunction lock() {\n  lockPiece(current);\n  clearLines();\n  spawnPiece();\n}\n\nfunction drawBlock(x, y, color, context = ctx, size = BLOCK) {\n  context.fillStyle = color;\n  context.fillRect(x * size, y * size, size, size);\n  context.strokeStyle = 'rgba(255,255,255,0.3)';\n  context.lineWidth = 1;\n  context.strokeRect(x * size, y * size, size, size);\n  context.fillStyle = 'rgba(255,255,255,0.15)';\n  context.fillRect(x * size, y * size, size * 0.3, size * 0.3);\n}\n\nfunction drawGhost() {\n  if (!current) return;\n  let ghostY = current.y;\n  while (isValidPosition(current, 0, ghostY - current.y + 1)) {\n    ghostY++;\n  }\n  if (ghostY === current.y) return;\n  ctx.globalAlpha = 0.25;\n  for (let y = 0; y < current.shape.length; y++) {\n    for (let x = 0; x < current.shape[y].length; x++) {\n      if (current.shape[y][x]) {\n        drawBlock(current.x + x, ghostY + y, current.color);\n      }\n    }\n  }\n  ctx.globalAlpha = 1;\n}\n\nfunction draw() {\n  ctx.fillStyle = '#000';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  // Grid lines\n  ctx.strokeStyle = '#222';\n  ctx.lineWidth = 1;\n  for (let x = 0; x <= COLS; x++) {\n    ctx.beginPath();\n    ctx.moveTo(x * BLOCK, 0);\n    ctx.lineTo(x * BLOCK, canvas.height);\n    ctx.stroke();\n  }\n  for (let y = 0; y <= ROWS; y++) {\n    ctx.beginPath();\n    ctx.moveTo(0, y * BLOCK);\n    ctx.lineTo(canvas.width, y * BLOCK);\n    ctx.stroke();\n  }\n\n  // Board\n  for (let y = 0; y < ROWS; y++) {\n    for (let x = 0; x < COLS; x++) {\n      if (board[y][x]) {\n        drawBlock(x, y, board[y][x]);\n      }\n    }\n  }\n\n  if (current) {\n    drawGhost();\n    for (let y = 0; y < current.shape.length; y++) {\n      for (let x = 0; x < current.shape[y].length; x++) {\n        if (current.shape[y][x]) {\n          drawBlock(current.x + x, current.y + y, current.color);\n        }\n      }\n    }\n  }\n}\n\nfunction drawNext() {\n  const size = 30;\n  nextCtx.fillStyle = '#000';\n  nextCtx.fillRect(0, 0, nextCanvas.width, nextCanvas.height);\n  if (!next) return;\n  const offsetX = (4 - next.shape[0].length) / 2;\n  const offsetY = (4 - next.shape.length) / 2;\n  for (let y = 0; y < next.shape.length; y++) {\n    for (let x = 0; x < next.shape[y].length; x++) {\n      if (next.shape[y][x]) {\n        drawBlock(offsetX + x, offsetY + y, next.color, nextCtx, size);\n      }\n    }\n  }\n}\n\nfunction drawGameOver() {\n  ctx.fillStyle = 'rgba(0,0,0,0.7)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = '#fff';\n  ctx.font = 'bold 36px sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 20);\n  ctx.font = '18px sans-serif';\n  ctx.fillText('Click New Game to restart', canvas.width / 2, canvas.height / 2 + 20);\n}\n\nfunction drawPause() {\n  ctx.fillStyle = 'rgba(0,0,0,0.7)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = '#fff';\n  ctx.font = 'bold 36px sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('PAUSED', canvas.width / 2, canvas.height / 2);\n}\n\nfunction updateUI() {\n  document.getElementById('score').textContent = score;\n  document.getElementById('lines').textContent = lines;\n  document.getElementById('level').textContent = level;\n}\n\nfunction update(time = 0) {\n  if (gameOver) return;\n\n  const delta = time - lastTime;\n  lastTime = time;\n\n  if (!paused) {\n    dropCounter += delta;\n    if (dropCounter > dropInterval) {\n      if (isValidPosition(current, 0, 1)) {\n        current.y++;\n      } else {\n        lock();\n      }\n      dropCounter = 0;\n    }\n  }\n\n  draw();\n  if (paused) drawPause();\n\n  animationId = requestAnimationFrame(update);\n}\n\nfunction newGame() {\n  if (animationId) cancelAnimationFrame(animationId);\n  board = createEmptyBoard();\n  score = 0;\n  lines = 0;\n  level = 1;\n  dropInterval = 1000;\n  dropCounter = 0;\n  gameOver = false;\n  paused = false;\n  current = null;\n  next = null;\n  updateUI();\n  spawnPiece();\n  update();\n}\n\ndocument.addEventListener('keydown', e => {\n  if (gameOver) return;\n\n  if (e.key === 'p' || e.key === 'P') {\n    paused = !paused;\n    if (!paused) {\n      lastTime = performance.now();\n      dropCounter = 0;\n    }\n    return;\n  }\n\n  if (paused || !current) return;\n\n  switch (e.key) {\n    case 'ArrowLeft':\n      if (isValidPosition(current, -1, 0)) current.x--;\n      break;\n    case 'ArrowRight':\n      if (isValidPosition(current, 1, 0)) current.x++;\n      break;\n    case 'ArrowDown':\n      if (isValidPosition(current, 0, 1)) {\n        current.y++;\n        score += 1;\n        dropCounter = 0;\n        updateUI();\n      }\n      break;\n    case 'ArrowUp': {\n      const rotated = rotate(current.shape);\n      let kick = 0;\n      if (!isValidPosition(current, 0, 0, rotated)) {\n        kick = isValidPosition(current, 1, 0, rotated) ? 1 : isValidPosition(current, -1, 0, rotated) ? -1 : 0;\n      }\n      if (kick !== undefined) {\n        current.shape = rotated;\n        current.x += kick;\n      }\n      break;\n    }\n    case ' ':\n      e.preventDefault();\n      hardDrop();\n      break;\n  }\n});\n\ndocument.getElementById('new-game').addEventListener('click', newGame);\n\nnewGame();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"54bb7f57-27ff-4e72-89f1-73e1f0b82674","userType":"external","entrypoint":"sdk-cli","cwd":"/workspace","sessionId":"35e4015a-d7d1-4f03-9263-ce5bca80c77f","version":"2.1.140","gitBranch":"HEAD"}
